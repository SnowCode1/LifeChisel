{
  "name": "onpurpose",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "expo": "~57.0.26",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-sensors": "~57.0.3",
    "expo-sharing": "~57.0.22",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "@onpurpose/core": "0.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go",
    "start:clear": "expo start --go --clear",
    "start:tunnel": "expo start --go --tunnel",
    "android": "adb reverse tcp:8081 tcp:8081 && expo start --go --localhost --android",
    "start:compare-dev": "node scripts/start-comparison.mjs development",
    "start:production-js": "node scripts/start-comparison.mjs production-js",
    "web": "expo start --web",
    "web:dev": "node scripts/web-dev.mjs",
    "web:build": "npm run build -w @onpurpose/web",
    "web:preview": "npm run preview -w @onpurpose/web",
    "landing:dev": "npm run dev -w @onpurpose/landing",
    "landing:build": "npm run build -w @onpurpose/landing",
    "landing:preview": "npm run preview -w @onpurpose/landing",
    "site:build": "npm run landing:build && npm run web:build && node scripts/build-site.mjs",
    "sync:dev": "npm run dev -w @onpurpose/sync",
    "sync:build": "npm run build:check -w @onpurpose/sync",
    "sync:deploy:dev": "npm run deploy:dev -w @onpurpose/sync",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web && tsc --noEmit -p apps/landing && tsc --noEmit -p apps/sync",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "doctor": "npx expo-doctor@latest",
    "export:ios": "expo export --platform ios",
    "export:android": "expo export --platform android",
    "android:screenshot": "node scripts/android-screenshot.mjs",
    "preview:server": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/preview-server.mjs",
    "test:preview": "node --max-old-space-size=256 --test --test-timeout=15000 scripts/preview-receiver.test.mjs",
    "test:calendar": "node --max-old-space-size=256 --test --test-timeout=15000 scripts/calendar.test.mjs",
    "test": "node --max-old-space-size=256 --test --test-concurrency=2 --test-timeout=15000 scripts/*.test.mjs apps/web/test/*.test.mjs",
    "benchmark:grid": "node scripts/benchmark-grid.mjs",
    "benchmark:bottlenecks": "node --max-old-space-size=256 scripts/benchmark-bottlenecks.mjs"
  },
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <25"
  }
}
